<form class="form-address">
  <div class="cep-logradouro">
    <div class="div-cep" id="div-cep">
      <label for="cep">CEP</label>
      <div class="input-group">
        <input type="text" id="cep" class="form-control cep" placeholder="CEP" aria-label="CEP"
          aria-describedby="button-addon2" maxlength="9" required>
        <div class="input-group-append">
          <button class="btn-cep" type="button" id="button-addon2">Procurar</button>
        </div>
      </div>
      <p class="obrigatorio">Obrigatório</p>
      <span id="msg-cep"></span>
    </div>
    <div class="div-logradouro">
      <label for="logradouro">Logradouro</label>
      <input type="text" name="logradouro" id="logradouro" class="form-control" placeholder="Logradouro" maxlength="70"
        required />
      <p class="obrigatorio">Obrigatório</p>
      <span id="msg-logradouro"></span>
    </div>
  </div>
  <div class="numero-complemento">
    <div class="div-numero">
      <label for="numero">Número</label>
      <input type="text" name="numero" id="numero" placeholder="Número" class="numero form-control" maxlength="45"
        required />
      <p class="obrigatorio">Obrigatório</p>
      <span id="msg-numero"></span>
    </div>
    <div class="div-complemento">
      <label for="complemento">Complemento</label>
      <input type="text" name="complemento" id="complemento" placeholder="Complemento" class="complemento form-control"
        maxlength="255" />
      <span id="msg-complemento"></span>
    </div>
  </div>
  <div class="uf-bairro">
    <div class="div-uf">
      <label for="uf">UF</label>
      <input type="text" name="uf" id="uf" placeholder="UF" class="uf form-control" maxlength="2" required />
      <p class="obrigatorio">Obrigatório</p>
      <span id="msg-uf"></span>
    </div>
    <div class="div-bairro">
      <label for="bairro">Bairro</label>
      <input type="text" name="bairro" id="bairro" placeholder="Bairro" class="bairro form-control" maxlength="50"
        required />
      <p class="obrigatorio">Obrigatório</p>
      <span id="msg-bairro"></span>
    </div>
  </div>
  <div class="cidade-telefone1">
    <div class="div-cidade">
      <label for="cidade">Cidade</label>
      <input type="text" name="cidade" id="cidade" placeholder="Cidade" class="cidade form-control" maxlength="50"
        required />
      <p class="obrigatorio">Obrigatório</p>
      <span id="msg-cidade"></span>
    </div>
    <div class="div-telefone1">
      <label for="telefone1">Telefone1</label>
      <input type="tel" name="telefone1" id="telefone1" placeholder="Telefone 1" class="telefone1 form-control"
        maxlength="15" required />
      <p class="obrigatorio">Obrigatório</p>
      <span id="msg-telefone1"></span>
    </div>
  </div>
  <div class="telefone2-email">
    <div class="div-telefone2">
      <label for="telefone2">Telefone2</label>
      <input type="tel" name="telefone2" id="telefone2" placeholder="Telefone 2" class="telefone2 form-control"
        maxlength="15" required />
      <p class="obrigatorio">Obrigatório</p>
      <span id="msg-telefone2"></span>
    </div>
    <div class="div-email">
      <label for="email">Email</label>
      <input type="email" name="email" id="email" placeholder="Email" class="email form-control" maxlength="45"
        autocomplete="email" required>
      <p class="obrigatorio">Obrigatório</p>
      <div id="msg-email"></div>
    </div>
  </div>
  <div class="instagram-linkedin">
    <div class="div-linkedin">
      <label for="linkedin">LinkedIn</label>
      <input type="text" name="linkedin" id="linkedin" placeholder="LinkedIn" class="linkedin form-control"
        maxlength="45" />
      <p class="obrigatorio">Obrigatório</p>
      <span id="msg-linkedin"></span>
    </div>
    <div class="div-instagram">
      <label for="instagram">Instagram</label>
      <input type="text" name="instagram" id="instagram" placeholder="Instagram" class="instagram form-control"
        maxlength="45" />
      <p class="obrigatorio">Obrigatório</p>
      <span id="msg-instagram"></span>
    </div>

  </div>
  <div>
    <span id="msg-fracasso-address"></span>
  </div>
  <div class="div-buttons-address">
    <button type="button" class="button-back-address ">Voltar</button>
    <div class="linha-ou-adress">
      <div class="line-div"></div>
      <div class="ou">OU</div>
      <div class="line-div"></div>
    </div>
    <button type="submit" id="submit-address" class="button-advanced-adress">Avançar</button>
  </div>
</form>
<div class="cep-found">
  <div class="alert-cep">
    <h1>CEP não encontrado</h1>
    <p>Favor enviar um e-mail para cep@cieemg.org.br informando o seu CEP e endereço.</p>
    <div class="button-confirm">
      <button class="button-confirm-cep">Confirmar</button>
    </div>
  </div>
</div>