    <select name="cursos" id="cursos" title="Selecione o curso.">
        <option disabled selected>Selecione</option>
        <option value="desafio" selected>Desafio</option>
    </select>
    <p class="obrigatorio">Obrigatório</p>
    <span id="msg-curso"></span>
</div>

