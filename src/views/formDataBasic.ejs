<form class="form-data">
  <div class="div-number-1">
    <div class="div-name">
      <label for="name">Nome</label>
      <input type="text" name="nome" class="name" placeholder="Nome" id="name" maxlength="255" autocomplete="given-name"
        required />
      <p class="obrigatorio">Obrigatório</p>
      <span id="msg-nome"></span>
    </div>

    <div class="div-cpf">
      <label for="cpf">CPF</label>
      <input type="text" name="cpf" autocomplete="off" maxlength="14" class="cpf" id="cpf" placeholder="CPF" required />
      <p class="obrigatorio">Obrigatório</p>
      <span id="msg-cpf"></span>
    </div>

    <div class="div-number-1-1">
      <div class="div-social">
        <input type="checkbox" name="social" class="social" placeholder="Nome Social" id="social" />
        <label for="social" class="label-nome-social">Prefiro usar nome social</label>
      </div>
    </div>
  </div>

  <div class="div-number-1-2">
    <div class="div-check-rg">
      <input type="checkbox" id="check-rg">
      <label class="label-check-rg" for="check-rg">Utilizo identidade antiga</label>
    </div>

    <div class="div-rg hide">
      <label for="rg">RG</label>
      <input type="text" name="rg" class="rg" placeholder="RG" id="rg" maxlength="15" />
      <p class="obrigatorio">Obrigatório</p>
      <span id="msg-rg"></span>
    </div>
  </div>

  <div class="div-orgao-expedidor">
    <label for="orgao-expedidor">Orgão Expedidor</label>
    <input type="text" name="orgaoExpedidor" class="orgao-expedidor" id="orgao-expedidor" placeholder="Orgão Expedidor"
      maxlength="45" required />
    <p class="obrigatorio">Obrigatório</p>
    <span id="msg-orgao-expedidor"></span>
  </div>

  <div class="div-number-2">
    <div class="div-nome-mae">
      <label for="nome-mae">Nome da Mãe (Responsável legal ou tutor):</label>
      <input type="text" name="nomeDaMae" class="nome-mae" placeholder="Nome da Mãe" id="nome-mae" maxlength="255"
        required />
      <p class="obrigatorio">Obrigatório</p>
      <span id="msg-nome-mae"></span>
    </div>
    <div class="div-cpf">
      <label for="cpf-mae">CPF Mãe (Responsável legal ou tutor)</label>
      <input type="text" name="cpf-mae" autocomplete="off" maxlength="14" class="cpf-pais mamae" id="cpf-mae"
        placeholder="CPF Mãe" />
      <span id="msg-cpf-mae"></span>
    </div>
  </div>

  <div class="div-number-2-5">
    <div class="div-nome-pai">
      <label for="nome-pai">Nome do Pai (Não obrigatório):</label>
      <input type="text" name="nomeDoPai" class="nome-pai" placeholder="Nome do Pai" id="nome-pai" maxlength="255" />
      <span id="msg-nome-pai"></span>
    </div>
    <div class="div-cpf">
      <label for="cpf-pai">CPF Pai (Não obrigatório):</label>
      <input type="text" name="cpf-pai" autocomplete="off" maxlength="14" class="cpf-pais papai" id="cpf-pai"
        placeholder="CPF Pai" />
      <span id="msg-cpf-pai"></span>
    </div>
  </div>
  </div>
  <div class="div-number-3">
    <div class="div-carteira-trabalho">
      <label for="carteira-trabalho">Carteira de Trabalho (Não obrigatório):</label>
      <input type="text" name="carteiraDeTrabalho" class="carteira-trabalho" id="carteira-trabalho"
        placeholder="Carteira de Trabalho" maxlength="20" />
      <span id="msg-carteira-trabalho"></span>
    </div>
    <div class="div-naturalidade">
      <label for="naturalidade">Naturalidade</label>
      <input type="text" class="naturalidade" placeholder="Naturalidade" id="naturalidade" maxlength="100"
        name="naturalidade" required />
      <p class="obrigatorio">Obrigatório</p>
      <span id="msg-naturalidade"></span>
    </div>
    <div class="div-nacionalidade">
      <label for="nacionalidade">Nacionalidade</label>
      <input type="text" class="nacionalidade" id="nacionalidade" placeholder="Nacionalidade" maxlength="100"
        name="nacionalidade" required />
      <p class="obrigatorio">Obrigatório</p>
      <span id="msg-nacionalidade"></span>
    </div>
  </div>
  <div class="div-number-4">
    <div class="div-data-nascimento">
      <label for="data-nascimento">Data de Nascimento</label>
      <input type="date" name="dataDeNascimento" class="data-nascimento" id="data-nascimento" min="1907-01-01"
        max="3000-12-31" required />
      <p class="obrigatorio">Obrigatório</p>
      <span id="msg-data-nascimento"></span>
    </div>
    <div class="div-estado-civil">
      <label for="estado-civil">Estado Civil</label>
      <select name="estadoCivil" class="estado-civil" id="estado-civil" required>
        <option value="" selected disabled>Selecione</option>
        <option value="S" name="solteiro">Solteiro(a)</option>
        <option value="C" name="casado">Casado(a)</option>
        <option value="A" name="amaziado">Amaziado(a)</option>
        <option value="D" name="divorciado">Divorciado(a)</option>
        <option value="V" name="viuvo">Viúvo(a)</option>
      </select>
      <p class="obrigatorio">Obrigatório</p>
      <span id="msg-estado-civil"></span>
    </div>
    <div class="div-naturalidade">
      <label for="uf-naturalidade">UF da Naturalidade</label>
      <select name="ufNaturalidade" class="uf-naturalidade" id="uf-naturalidade" required>
        <option value="" disabled selected>Selecione</option>
      </select>
      <p class="obrigatorio">Obrigatório</p>
      <span id="msg-uf-naturalidade"></span>
    </div>

  </div>
  <div class="div-number-4-5">
    <div class="form-group-um">
            <h4 class="label-title">7. Qual a sua identidade de gênero? <span
                    class="span-obrigatorio">Obrigatório</span></h4>
            <div class="form-check">
                <input type="radio" class="form-check-input" id="cisgenero" name="genero" value="C" required>
                <label for="cisgenero" class="form-check-label">Cisgênero: pessoa que se identifica com as
                    características do
                    sexo designado a ela no nascimento </label>
            </div>
            <div class="form-check">
                <input type="radio" class="form-check-input" id="transgenero" name="genero" value="T" required>
                <label for="transgenero" class="form-check-label">Transgênero: pessoa que não se identifica com
                    ascaracterísticas
                    do sexo designado a elano nascimento</label>
            </div>
        </div>

        <div class="form-group-dois">
            <h4 class="label-title">8. Como você se declara: <span class="span-obrigatorio">Obrigatório</span></h4>
            <div class="form-check">
                <input type="radio" class="form-check-input" id="negro" name="etnia" value="N" required>
                <label for="negro" class="form-check-label">Negro</label>
            </div>
            <div class="form-check">
                <input type="radio" class="form-check-input" id="branco" name="etnia" value="B" required>
                <label for="branco" class="form-check-label">Branco</label>
            </div>
            <div class="form-check">
                <input type="radio" class="form-check-input" id="pardo" name="etnia" value="P" required>
                <label for="pardo" class="form-check-label">Pardo</label>
            </div>
            <div class="form-check">
                <input type="radio" class="form-check-input" id="amarelo" name="etnia" value="A" required>
                <label for="amarelo" class="form-check-label">Amarelo</label>
            </div>
            <div class="form-check">
                <input type="radio" class="form-check-input" id="indigena" name="etnia" value="I" required>
                <label for="indigena" class="form-check-label"> Indígena (possui declaração de vínculo com a comunidade
                    indígena pela FUNAI)
                </label>
            </div>
        </div>
  </div>
  <div class="div-number-5" >
    <div class="div-sexo">
      <label for="sexo">Sexo</label>
      <select name="sexos" class="sexo" id="sexo" required>
        <option value="" disabled selected>Selecione</option>
        <option value="M" name="masculino">Masculino</option>
        <option value="F" name="feminino">Feminino</option>
      </select>
      <p class="obrigatorio">Obrigatório</p>
      <span id="msg-sexo"></span>
    </div>
    <div class="div-deficiencias">
      <label for="deficiencias">Possui alguma necessidade especial?</label>
      <select name="deficiencias" class="deficiencias" id="deficiencias" required>
        <option value="" disabled selected>Selecione</option>
        <option value="N" name="nao">Não</option>
        <option value="F" name="fisica">Física</option>
        <option value="A" name="auditiva">Auditiva</option>
        <option value="V" name="visual">Visual</option>
        <option value="ME" name="mental">Mental</option>
        <option value="MU" name="multipla">Múltipla</option>
        <option value="TE" name="transtornoDoEspectro">
          Transtorno do Espectro Autista (TEA)
        </option>
      </select>
      <p class="obrigatorio">Obrigatório</p>
      <span id="msg-deficiencias"></span>
    </div>
  </div>
  <div class="div-descricao-deficiencia">
    <div class="descricao-deficiencia">
    </div>
    <div id="div-laudo-deficiencia" class="hide">
      <label for="laudo-deficiencia">Anexe o Laudo Médico (Não obrigatório):</label>
      <input type="file" name="laudo_deficiencia" class="laudo-deficiencia form-control" id="laudo-deficiencia"
        placeholder="Anexe o laudo médico" maxlength="255" />
      <p class="obrigatorio">Não obrigatório</p>
    </div>
    <span id="msg-descricao"></span>
  </div>
  <div>
    <span id="msg-fracasso"></span>
  </div>
  <div class="div-buttons-data">
    <button class="button-advanced-data-basic" type="submit">Avançar</button>
  </div>
</form>