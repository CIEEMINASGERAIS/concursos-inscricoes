<!DOCTYPE html>
<html lang="PT-BR">

<head>
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="stylesheet" href="css/style.css" />
  <link rel="stylesheet" href="css/termosCondicoes.css" />
  <link rel="stylesheet" href="css/dataBasic.css" />
  <link rel="stylesheet" href="css/address.css">
  <link rel="stylesheet" href="css/schoolData.css" />
  <link rel="stylesheet" href="css/socioEconomic.css" />
  <link rel="stylesheet" href="css/footer.css">
  <link rel="icon" href="images/favicon-16x16.png">
  <title>CIEEMG</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.1.3/dist/css/bootstrap.min.css" />
  <link rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/bootstrap-select@1.13.14/dist/css/bootstrap-select.min.css" />
</head>

<body>
  <div class="all">
    <main class="screen-main">
      <!-- <div class="terms-and-conditions">
      </div> -->
      <div class="sub-main-title">
        <h1 class="h1-sub-title">Termos e condições</h1>
      </div>
      <nav class="screen screen-terms-conditions"></nav>
      <nav class="screen screen-basic-data1"></nav>
      <nav class="screen screen-address"></nav>
      <nav class="screen screen-school-data"></nav>
      <nav class="screen screen-socio-economic"></nav>
    </main>
    <nav class="fixed">
      <nav class="nav-bar position main">
        <div class="container main">
          <img class="main" src="images/CIEE-2023-atualizado.png" alt="Logo do CIEEMG" />
        </div>
        <div class="main-side main">
          <div id="item-terms-conditions">
            <button class="big-terms-conditions main" title="Termos e
          Condições"><img class="button-terms-conditions main" src="images/terms-32.png"
                alt="Termos e Condições" />Termos e
              Condições</button>
          </div>
          <div id="item-data-basic">
            <button class="big-basic-data main" title="Dados
          Básicos"><img class="button-basic-data main" src="images/basic-data-32.png" alt="Dados Básicos" />Dados
              Básicos</button>
          </div>
          <div id="item-address">
            <button type="submit" class="big-address main" title="Endereço"><img class="button-address main"
                src="images/address-32.png" alt="Endereço" />Endereço</button>
          </div>
          <div id="item-school-data">
            <button class="big-school-data main" title="Dados Acadêmicos"><img class="button-school-data main"
                src="images/school-data-32.png" alt="Dados Acadêmicos" />Dados
              Acadêmicos</button>
          </div>
          <div id="item-socio-economic">
            <button class="big-socio-economic main" title="Avaliação Social"><img class="button-socio-economic main"
                src="images/av.social-32.png" alt="Avaliação Social" />Avaliação social</button>
          </div>
        </div>
        <div class="main-side-mobile main">
          <div id="item-terms-conditions">
            <button class="main" title="Termos e condições"><img class="button-terms-conditions main"
                src="images/terms-32.png" alt="Termos e Condições" /></button>
          </div>
          <div id="item-data-basic">
            <button class="main" title="Dados Básicos"><img class="button-basic-data main"
                src="images/basic-data-32.png" alt="Dados Básicos" /></button>
          </div>
          <div id="item-address">
            <button class="main" title="Endereço"><img class="button-address main" src="images/address-32.png"
                alt="Endereço" /></button>
          </div>
          <div id="item-school-data">
            <button class="main" title="Dados Acadêmicos"><img class="button-school-data main"
                src="images/school-data-32.png" alt="Dados Acadêmicos" /></button>
          </div>
          <div id="item-socio-economic">
            <button class="main" title="Avaliação Social"><img class="button-socio-economic main"
                src="images/av.social-32.png" alt="Avaliação Social Socio-econômico" /></button>
          </div>

        </div>
      </nav>
    </nav>
    <footer class="footer-index">
      <p class="oie">Copyright ©2024 CIEEMG. Todos os direitos reservados | Desenvolvido por TI CIEEMG</p>
    </footer>
  </div>
  <script src="https://code.jquery.com/jquery-3.3.1.slim.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/popper.js@1.14.3/dist/umd/popper.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.1.3/dist/js/bootstrap.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap-select@1.13.14/dist/js/bootstrap-select.min.js"></script>
  <script src="js/bundle.js"></script>
</body>

</html>