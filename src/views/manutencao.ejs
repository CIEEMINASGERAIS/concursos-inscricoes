<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="images/favicon-16x16.png">
    <title>CIEEMG</title>
    <style>
        * {
            font-family: 'Courier New';
        }
        .tudo {
            display: flex;
            flex-direction: column;
            align-items: center;
            font-size: 1.5rem;
            width: 100%;
        }
        .logo {
            display: flex;
            flex-direction: column;
            align-items: center;
        }
        @media screen and (max-width:1035px) {
            .img1 {
                width: 100%;
            }
        }
        @media screen and (max-width:400px) {
            .tudo {
                font-size: 1rem;
            }
        }
        @media screen and (max-width:220px) {
            .tudo {
                font-size: 0.5rem;
            }
        }
    </style>
</head>
<body>
    <footer>
        <div class="tudo">
            <h1>Site em manutenção, tente novamente mais tarde.</h1>
            <hr>
        </div>
        <div class="logo">
            <img class="img1" src="images/Logo CIEE (completa).png" alt="">
        </div>
    </footer>
</body>
</html>