<form class="form-programa-cursos">
    <div class="form-group">
        <h4 class="label-title">Programas em curso disponiveis, deseja participar?<span
                class="span-obrigatorio">Obrigatório</span>
        </h4>
        <div class="form-check">
            <input type="radio" class="form-check-input spc" id="s-p-c" name="programas-curso" value="S" required>
            <label for="s-p-c" class="form-check-label">Sim</label>
        </div>
        <div class="form-check">
            <input type="radio" class="form-check-input npc" id="n-p-c" name="programas-curso" value="N" required>
            <label for="n-p-c" class="form-check-label">Não</label>
        </div>
    </div>
    <div id="div-programas" class="programas-cursos">
        <span id="msg-curso"></span>
    </div>
    <div class="form-group div-desafio">
        <!-- <h4 class="label-title">1. Como você ficou sabendo deste desafio?<span
                class="span-obrigatorio">Obrigatório</span>
        </h4> -->
    </div>
    <div class="form-group">
        <h4 class="label-title">2. O que mais te chamou a atenção neste desafio? <span
                class="span-obrigatorio">Obrigatório</span></h4>
        <div class="form-check">
            <input type="radio" class="form-check-input" id="pergunta1" name="rendas" required value="1">
            <label for="1salario" class="form-check-label"> A possibilidade de expressar a minha opinião</label>
        </div>
        <div class="form-check">
            <input type="radio" class="form-check-input" id="pergunta1" name="rendas" value="2" required>
            <label for="2salarios" class="form-check-label"> Até 2
                A oportunidade de dar visibilidade a um trabalho meu</label>
        </div>
        <div class="form-check">
            <input type="radio" class="form-check-input" id="pergunta1" name="rendas" value="3" required>
            <label for="3salarios" class="form-check-label"> Tenho interesse em uma bolsa de estudos</label>
        </div>
        <div class="form-check">
            <input type="radio" class="form-check-input" id="pergunta1" name="rendas" value="4" required>
            <label for="4salarios" class="form-check-label"> Gostaria de receber uma mentoria</label>
        </div>
        <div class="form-check">
            <input type="radio" class="form-check-input" id="pergunta1" name="comoEncontrou" value="5" required>
            <label for="escola-federal" class="label-desafio-encontro"> Outros</label>
        </div>
        <div>
            <input type="text" name="imovel" class="form-control" id="imovel" placeholder="Outros" required>
        </div>
    </div>
    <div>
        <span id="msg-fracasso-socio-economy"></span>
    </div>
    <div class="div-buttons">
        <button class="button-back-socio" type="button">Voltar</button>
        <div class="linha-ou-socio">
            <div class="line-div"></div>
            <div class="ou">OU</div>
            <div class="line-div"></div>
        </div>
        <button class="button-finish-socio" type="submit">Avançar</button>
    </div>
</form>