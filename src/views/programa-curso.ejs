<form class="form-programa-cursos">
    <div class="form-group">
        <h4 class="label-title">Programas em curso disponiveis, deseja participar?<span
                class="span-obrigatorio">Obrigatório</span>
        </h4>
        <div class="form-check">
            <input type="radio" class="form-check-input spc" id="s-p-c" name="programas-curso" value="S" required>
            <label for="s-p-c" class="form-check-label">Sim</label>
        </div>
        <div class="form-check">
            <input type="radio" class="form-check-input npc" id="n-p-c" name="programas-curso" value="N" required>
            <label for="n-p-c" class="form-check-label">Não</label>
        </div>
    </div>
    <div id="div-programas" class="programas-cursos">
        <span id="msg-curso"></span>
    </div>
    <div class="form-group div-desafio">
    </div>
    <div class="form-group div-chamou-desafio">
    </div>
    <div>
        <span id="msg-fracasso-socio-economy"></span>
    </div>
    <div class="div-buttons">
        <button class="button-back-programa" type="button">Voltar</button>
        <div class="linha-ou-socio">
            <div class="line-div"></div>
            <div class="ou">OU</div>
            <div class="line-div"></div>
        </div>
        <button class="button-finish-programa" type="submit">Finalizar</button>
    </div>
</form>
<div class="end">
    <div class="alert">
    </div>
</div>