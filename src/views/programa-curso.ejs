<form class="form-programa-cursos">
    <div class="form-group">
        <h4 class="label-title">Programas e cursos disponiveis, deseja participar?<span
                class="span-obrigatorio">Obrigatório</span>
        </h4>
        <div class="form-check">
            <input type="radio" class="form-check-input" id="s-p-c" name="programas-curso" value="S" required>
            <label for="s-p-c" class="form-check-label">Sim</label>
        </div>
        <div class="form-check">
            <input type="radio" class="form-check-input" id="n-p-c" name="programas-curso" value="N" required>
            <label for="n-p-c" class="form-check-label">Não</label>
        </div>
    </div>

    <div class="programas-em-curso">

    </div>

    <div>
        <span id="msg-fracasso-socio-economy"></span>
    </div>
    <div class="div-buttons">
        <button class="button-back-socio" type="button">Voltar</button>
        <div class="linha-ou-socio">
            <div class="line-div"></div>
            <div class="ou">OU</div>
            <div class="line-div"></div>
        </div>
        <button class="button-finish-socio" type="submit">Finalizar</button>
    </div>

</form>